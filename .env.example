# ============================================================
#  AI-автоответчик для личного Telegram — настройки юзербота
#  Скопируйте в .env и впишите свои значения
# ============================================================

# ---- Telegram (https://my.telegram.org -> API development tools) ----
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Имя файла сессии (создастся ai_responder.session)
SESSION_NAME=ai_responder

# ---- AI-ключ (https://aistudio.google.com -> Get API key) ----
GEMINI_API_KEY=AIza...

# ---- Telegram-бот (https://t.me/BotFather -> /newbot) ----
# Управляющий бот (@myaccounttbot): в режиме bot_chat сюда приходят
# варианты ответа с кнопками [1] [2] [3]
BOT_TOKEN=1234567890:AAA...BBB
# Ваш Telegram user id (узнать: @userinfobot). Если пусто — берётся id вашего аккаунта.
MY_TELEGRAM_ID=

# ---- n8n: публичный адрес (ngrok/cloudflared) и вебхук ----
# WEBHOOK_URL — база; N8N_WEBHOOK_URL — полный адрес вебхука (приоритетнее)
WEBHOOK_URL=https://xxxx.ngrok-free.dev
N8N_WEBHOOK_URL=https://xxxx.ngrok-free.dev/webhook/telegram-in
# Таймаут ожидания ответа n8n, сек
N8N_TIMEOUT_SEC=90

# ---- Callback-сервер userbot (команды от n8n) ----
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=8123
# Тот же ключ, что встроен в n8n/workflow_send_callbacks.json (X-Api-Key)
CALLBACK_API_KEY=change-me-strong-secret

# ---- Служебный чат (fallback для уведомлений) ----
# "me" = Избранное (режим userbot), или id группы -100... (режим bot)
# В режиме bot_chat сюда дублируются предупреждения, если чат с ботом недоступен.
SERVICE_CHAT_ID=me

# ---- Режим кнопок ----
# bot_chat — варианты с кнопками [1][2][3] приходят в личный чат с ботом
#            (@myaccounttbot); нажатия обрабатывает сам userbot (long polling).
#            РЕКОМЕНДУЕТСЯ: n8n нужен только для генерации вариантов.
# userbot  — кнопки в «Избранном» (старый режим, работает без бота)
# bot      — кнопки рисует Telegram-бот через n8n (нужна группа и публичный URL)
AI_MODE=bot_chat

# Максимум вариантов ответа от n8n
MAX_SUGGESTIONS=3
