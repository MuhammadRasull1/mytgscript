      "parameters": {
        "jsCode": "// Обработка callback_query от inline-кнопок бота\nconst cq = $json.callback_query || {};\nlet parsed = {};\ntry { parsed = JSON.parse(cq.data || '{}'); } catch (e) { parsed = {}; }\n\n// Защита: отвечаем только владельцу (OWNER_ID в переменных n8n)\nconst owner = process.env.OWNER_ID ? String(process.env.OWNER_ID) : null;\nconst fromId = cq.from ? String(cq.from.id) : null;\nif (owner && fromId !== owner) return [[], [], []];\n\nconst msg = cq.message || {};\nconst base = {\n  peer_id: parsed.p,\n  message_id: parsed.m,\n  index: parsed.i,\n  callback_query_id: cq.id,\n  bot_chat_id: msg.chat ? msg.chat.id : null,\n  bot_message_id: msg.message_id,\n  bot_message_text: msg.text || '',\n};\n\nconst action = parsed.a || 'skip';\nif (action === 'send') {\n  return [[{ json: { ...base, command: 'send_reply', answer_text: '✅ Отправлено' } }], [], []];\n}\nif (action === 'edit') {\n  return [[], [{ json: { ...base, command: 'edit_reply', answer_text: '✏️ Создано сообщение для правки' } }], []];\n}\nreturn [[], [], [{ json: { ...base, answer_text: '⏭ Пропущено' } }]];",
        "mode": "runOnceForAllItems"
      },
      "id": "d4c1e5f2-2000-4000-8000-000000000002",
